rules_version = '2';
// Shared by the Blood Bridge mobile app and the Blood Bridge website (one Firebase project).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'admin@bloodbridge.demo'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function validCnic(d) { return d.get('cnicNumber', '') is string && d.get('cnicNumber', '').matches('^[0-9]{5}-[0-9]{7}-[0-9]$'); }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn();
      // New accounts start incomplete (the admin account is created as admin).
      allow create: if isAdmin() || (signedIn() && me() == userId
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('status', 'incomplete') in ['incomplete', 'pending']
        && request.resource.data.get('seeded', false) == false);
      // Owners can't change their role. Status may move to pending (submitted) or to approved
      // only with a well-formed CNIC (the app's OCR check / the website's automatic review).
      allow update: if isAdmin() || (signedIn() && me() == userId
        && !changed().hasAny(['role', 'seeded', 'uid'])
        && (!changed().hasAny(['status', 'cnicVerified'])
            || request.resource.data.status in ['incomplete', 'pending']
            || (request.resource.data.status == 'approved' && validCnic(request.resource.data))));
      allow delete: if isAdmin();
    }

    // ── Donation offer posts ──────────────────────────────────────────────────
    match /donations/{donationId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.uid == me() || isAdmin());
      // Others may only add themselves to the contact-consent fields.
      allow update: if signedIn() && (resource.data.uid == me() || isAdmin()
        || changed().hasOnly(['contactRequests', 'contactApprovedFor', 'updatedAt']));
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // ── SOS / urgent requests ─────────────────────────────────────────────────
    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.uid == me() || isAdmin());
      allow update: if signedIn() && (resource.data.uid == me() || isAdmin()
        || changed().hasOnly(['responders', 'contactRequests', 'contactApprovedFor', 'updatedAt']));
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // ── Confirmed donation records (certificates, leaderboard) ───────────────
    match /donationRecords/{recordId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.donorUid == me() || isAdmin());
      allow update, delete: if signedIn() && (resource.data.donorUid == me() || isAdmin());
    }

    // ── Chats (real-time subcollection model) ─────────────────────────────────
    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || me() in resource.data.participants || isAdmin());
      allow create: if signedIn() && me() in request.resource.data.participants;
      allow update: if signedIn() && me() in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function chat() { return getAfter(/databases/$(database)/documents/chats/$(chatId)).data; }
        function isSeeded(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.get('seeded', false) == true; }
        allow read: if signedIn() && (me() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        // Messages are sent as yourself; the demo community's seeded donors can auto-reply in your chats.
        allow create: if signedIn() && me() in chat().participants
          && (request.resource.data.senderId == me()
              || (request.resource.data.senderId in chat().participants && isSeeded(request.resource.data.senderId)));
        allow update, delete: if signedIn() && resource.data.senderId == me();
      }
    }

    // ── Notifications (per-user feed) ─────────────────────────────────────────
    match /notifications/{userId}/items/{itemId} {
      allow read, update, delete: if signedIn() && (me() == userId || isAdmin());
      // Anyone signed in can notify another user (SOS broadcast, messages, contact requests).
      allow create: if signedIn();
    }

    // ── Public counters for the logged-out landing page ──────────────────────
    match /stats/{statId} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['donors', 'requests', 'donations', 'records', 'updatedAt']);
    }
  }
}
