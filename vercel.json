{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run setup-db && npm run build",
  "functions": { "api/index.js": { "maxDuration": 15 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
